/*
 * userSMCfg.h.sample —— stateMachineC 库的用户配置文件参考样例
 *
 * 说明：本文件带 .sample 后缀，不会被任何头文件搜索路径当作配置文件使用，
 *       它的作用只是给你一个可以照抄的样例，请不要在本库目录内修改它。
 *
 * 使用说明：
 * 1、在你的项目里新建 userSMCfg.h（文件名去掉 .sample），把下面的宏抄进去并按项目情况修改，
 *    不需要改动 stateMachineC 模块本身的任何代码；同时把 src/ 目录加入头文件搜索路径。
 * 2、stateMachine.h 会引用你项目里的 userSMCfg.h。如果编译时提示
 *    “please #define DMEM_BUFFER_SIZE //in userSMCfg.h” 或
 *    “please #define SM_CYCLE_TIME_MS //in userSMCfg.h”，
 *    说明这个文件没有被找到，或对应宏被注释掉了。
 * 3、库内不自带定时器，轮询节拍由你按固定周期调用 fsm_run() 产生，
 *    所以 SM_CYCLE_TIME_MS 必须与你实际的调用周期一致：
 *    状态单元里的 roundCounter 以“拍”为单位累加，CNTSOFms / CNTSOFs 也按它换算。
 */
#ifndef _USER_SM_CFG_H_
#define _USER_SM_CFG_H_

/* 状态机运行周期（一拍 = 多少毫秒）
 * 必须与调用 fsm_run() 的实际周期一致，例如主程序每 10ms 调一次，就填 10。 */
#define SM_CYCLE_TIME_MS          10

/* 状态机层的数据 buffer：FULL / PART / TINY 三选一
 *   SM_BUFFER_FULL	全量：bool / i8 / u8 / i16 / u16 / i32 / u32 / f32 + 一个 void*
 *   SM_BUFFER_PART	部分：d8 / d16 / d32 三个联合体 + 一个 void*
 *   SM_BUFFER_TINY	最小：只有 d16（到 16 位）
 * 三个都不定义 = 不用 buffer。代码只认这三个名字，
 * 头文件说明里那个 SM_BUFFER_NO 只是旧写法留下的占位，不必抄（抄了也不影响）。
 * 用途：在不同的状态之间传数据，省掉一堆全局变量。 */
// #define SM_BUFFER_FULL
// #define SM_BUFFER_PART
// #define SM_BUFFER_TINY

/* 状态层的数据 buffer：同上，三选一，都不定义 = 状态单元不带宽 buffer
 * 每个状态单元各有一份，所以 RAM 占用 = 状态数 × sizeof(stBuffer_t)。 */
// #define ST_BUFFER_FULL
// #define ST_BUFFER_PART
// #define ST_BUFFER_TINY

/* 状态机静态内存池大小（字节）
 * fsm_init / fsm_eventSignUp 都从这块池里切内存：状态单元数组、事件节点、enterCounterOf 数组……
 * 池子里切不出来时，会先调用 warningFunc 报警，然后 while(1) 死等 —— 所以宁可先给大。
 * 项目定形后，按 map 里 DMEMORY 段的实际占用（调试时可临时把 stateMachine.c 里的 bufferUsed
 * 改成非 static 打印出来），把这个值缩到实际用量附近。 */
#define DMEM_BUFFER_SIZE          512

/* 可选：SM_MEM 指定状态机对象、状态单元、事件节点与内存池的存放区
 * 在 51 类单片机上，可按项目情况指定 data/idata/xdata/pdata，
 * 例如： #define SM_MEM      xdata
 * 不定义时表示不限定存储区（由编译器默认处理）。
 *
 * 注意：存储类修饰符是类型的一部分，开关 SM_MEM 时下面这些要一起走：
 *   1) 应用侧对象声明写 stateMachine_t SM_MEM xxx;（漏写会报一串 C150，照着补上即可）
 *   2) 回调参数统一用库里给的 smUnitPtr_t，不要自己写 smUnit_t*（后者是 edata 指针，会报 C98/C91）；
 *   3) 池里既有 uint32_t 数组也有结构体，库内对齐粒度已固定为 4 字节，不必再按 sizeof(void*) 算。
 *
 * 两条踩过的坑：
 *   4) xdata 对象不要写初始化器（C251 不为 xdata 生成启动初始化代码，初值会被静默丢弃），
 *      交给 fsm_init 赋值即可；
 *   5) 库内统计池用量的 bufferUsed 固定在 edata（它需要启动清零），不受 SM_MEM 影响，你不用管。
 */
// #define SM_MEM      xdata

#endif /* _USER_SM_CFG_H_ */
